{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amirqaru",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1f241d63-5d5d-4d21-8f50-53a5281548e8","database_name": "Amirhossein" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "6b969c74a5cc42ef847ef23002aa9999" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
